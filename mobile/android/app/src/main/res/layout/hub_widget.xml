<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hub_widget_background"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/widget_open"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/widget_open"
        android:textColor="@color/hub_widget_text"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/widget_compose"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/widget_compose"
        android:textColor="@color/hub_widget_text"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/widget_status"
        android:textColor="@color/hub_widget_text"
        android:textSize="14sp" />
</LinearLayout>
