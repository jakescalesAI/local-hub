// trylocalhub.com: the static site in site/, served by Cloudflare as a Worker with static assets.
// Deploy from the repo root with `npx wrangler deploy` after `npx wrangler login`.
// The custom domains below make Cloudflare create the DNS records and certificates on deploy.
{
  "name": "trylocalhub",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "trylocalhub.com", "custom_domain": true },
    { "pattern": "www.trylocalhub.com", "custom_domain": true }
  ],
  "workers_dev": false
}
